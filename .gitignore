# Publish only extension runtime files and repository/packaging metadata.
/*
!/.gitignore
!/.vscodeignore
!/README.md
!/package.json
!/extension.js
!/qe-detection.js
!/vasp-detection.js
!/qe-syntax-data.json
!/vasp-syntax-data.json
!/language-configuration*.json
!/syntaxes/
/syntaxes/*
!/syntaxes/*.tmLanguage.json

# Local development, calculations and downloaded source/potential data.
/test/
/tests/
/tools/
/examples/
/node_modules/
/.vscode/
/.vscode-test/
/.codex/
/.agents/
/.aws/

# Local artifacts and caches.
*.vsix
out*.txt
__pycache__/
.DS_Store
/CHANGELOG.md
/package-lock.json
