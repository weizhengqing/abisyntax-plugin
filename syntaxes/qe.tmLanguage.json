{
  "name": "Quantum ESPRESSO Input",
  "scopeName": "source.qe",
  "comment": "Generated by tools/build_qe_grammars.py; edit the builder.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#namelist"
    },
    {
      "include": "#assignment"
    },
    {
      "include": "#cards"
    },
    {
      "include": "#species"
    },
    {
      "include": "#values"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "!",
          "end": "$",
          "name": "comment.line.exclamation.qe"
        },
        {
          "begin": "^\\s*#",
          "end": "$",
          "name": "comment.line.number-sign.qe"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.qe",
          "applyEndPatternLast": true,
          "patterns": [
            {
              "match": "''",
              "name": "constant.character.escape.qe"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.qe",
          "applyEndPatternLast": true,
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.qe"
            }
          ]
        }
      ]
    },
    "namelist": {
      "patterns": [
        {
          "match": "(?i)^\\s*(?:&end\\b|/)|&end\\b",
          "name": "punctuation.definition.namelist.end.qe"
        },
        {
          "match": "^\\s*(&)([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.namelist.qe"
            },
            "2": {
              "name": "storage.type.namelist.qe"
            }
          }
        }
      ]
    },
    "cards": {
      "patterns": [
        {
          "match": "(?i)^\\s*(TARGET_OCCUPATION_NUMBERS|ADDITIONAL_K_POINTS|REF_CELL_PARAMETERS|BEGIN_ENGINE_INPUT|INTERMEDIATE_IMAGE|ATOMIC_VELOCITIES|ATOMIC_POSITIONS|BEGIN_PATH_INPUT|END_ENGINE_INPUT|BEGIN_POSITIONS|CELL_PARAMETERS|CLIMBING_IMAGES|ATOMIC_SPECIES|END_PATH_INPUT|ATOMIC_FORCES|END_POSITIONS|PLOT_WANNIER|TOTAL_CHARGE|CONSTRAINTS|FIRST_IMAGE|OCCUPATIONS|LAST_IMAGE|USER_STARS|AUTOPILOT|GAMMA_VAL|ROUGHNESS|ENDRULES|K_POINTS|SOLVENTS|HUBBARD|BEGIN|END)\\b(?![ \\t]*(?:\\([^()\\r\\n]*\\)[ \\t]*)?=)",
          "captures": {
            "1": {
              "name": "keyword.control.card.qe"
            }
          }
        },
        {
          "match": "(?i)\\b(?:alat|bohr|angstrom|crystal_sg|crystal_b|crystal_c|crystal|tpiba_b|tpiba_c|tpiba|automatic|gamma|atomic|ortho-atomic|norm-atomic|wf|pseudo)\\b",
          "name": "support.constant.option.qe"
        },
        {
          "match": "(?i)^\\s*(?:U|J0|J|V|B|E2|E3|ALPHA)\\b(?![ \\t]*(?:\\([^()\\r\\n]*\\)[ \\t]*)?=)",
          "name": "keyword.other.hubbard.qe"
        }
      ]
    },
    "assignment": {
      "match": "(?i)\\b([a-z_]\\w*(?:%[a-z_]\\w*)*)(\\s*\\([^\\n()]*\\))?(\\s*)(=)",
      "captures": {
        "1": {
          "name": "keyword.other.variable.qe"
        },
        "2": {
          "name": "meta.array-index.qe",
          "patterns": [
            {
              "include": "#values"
            }
          ]
        },
        "4": {
          "name": "keyword.operator.assignment.qe"
        }
      }
    },
    "species": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z][\\w+-]*)(?=\\s+[-+.\\d])",
          "captures": {
            "1": {
              "name": "constant.language.species.qe"
            }
          }
        },
        {
          "match": "(?i)(?<![\\w])[^\\s\\x27\"!,]+\\.upf\\b",
          "name": "string.unquoted.pseudopotential.qe"
        },
        {
          "match": "(?i)(?<![\\w])\\d+[spdfghij](?![\\w])",
          "name": "constant.language.orbital.qe"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "match": "(?i)\\.(?:true|false|t|f)\\.",
          "name": "constant.language.boolean.qe"
        },
        {
          "match": "(?<![\\w.])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eEdD][-+]?\\d+)?(?![\\w.])",
          "name": "constant.numeric.qe"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.qe"
        },
        {
          "match": "(?i)\\.(?:and|or|not|eqv|neqv|eq|ne|lt|le|gt|ge)\\.|[*/:+<>-]",
          "name": "keyword.operator.qe"
        },
        {
          "match": ",",
          "name": "punctuation.separator.qe"
        },
        {
          "match": "[(){}\\[\\]]",
          "name": "punctuation.section.qe"
        }
      ]
    }
  }
}
