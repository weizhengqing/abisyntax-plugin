{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VASP POSCAR",
  "scopeName": "source.vasp",
  "patterns": [
    {
      "comment": "The first line of a POSCAR is a free-form title.",
      "match": "\\A.*$",
      "name": "comment.line.title.vasp"
    },
    {
      "match": "(?i)^\\s*(selective(?:\\s+dynamics)?|direct|cartesian|reciprocal)\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.vasp"
        }
      }
    },
    {
      "comment": "Species line (VASP 5+): Si C  /  Fe_pv O",
      "begin": "^(?=\\s*[A-Z][a-z]?(?:[_/]\\S*)?(?:\\s+[A-Z][a-z]?(?:[_/]\\S*)?)*\\s*$)",
      "end": "$",
      "patterns": [
        {
          "match": "[A-Z][a-z]?(?:[_/]\\S*)?",
          "name": "entity.name.tag.element.vasp"
        }
      ]
    },
    {
      "comment": "Three coordinates, optional selective-dynamics flags, optional trailing label/comment.",
      "match": "^\\s*([-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?)\\s+([-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?)\\s+([-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?)(?:\\s+([TF])\\s+([TF])\\s+([TF]))?(?:\\s+(\\S.*?))?\\s*$",
      "captures": {
        "1": {
          "name": "constant.numeric.float.vasp"
        },
        "2": {
          "name": "constant.numeric.float.vasp"
        },
        "3": {
          "name": "constant.numeric.float.vasp"
        },
        "4": {
          "name": "constant.language.boolean.vasp"
        },
        "5": {
          "name": "constant.language.boolean.vasp"
        },
        "6": {
          "name": "constant.language.boolean.vasp"
        },
        "7": {
          "name": "comment.line.label.vasp"
        }
      }
    },
    {
      "match": "(?<![\\w.])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?(?![\\w.])",
      "name": "constant.numeric.vasp"
    },
    {
      "match": "[#!].*$",
      "name": "comment.line.vasp"
    }
  ]
}
