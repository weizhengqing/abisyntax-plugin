          "name": "keyword.other.unit.vasp"
        },
        {
          "match": "(?<![\\w.])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eEdD][-+]?\\d+)?(?![\\w.])",
          "name": "constant.numeric.vasp"
        },
        {
          "match": "\\*",
          "name": "keyword.other.operator.repeat.vasp"
        },
        {
          "match": "\\\\\\s*$",
          "name": "keyword.other.operator.continuation.vasp"
        },
        {
          "match": "[=;,:{}()\\[\\]+/<>|%~-]",
          "name": "keyword.other.operator.vasp"
        },
        {
          "match": "[^\\s\\w]",
          "name": "keyword.other.symbol.vasp"
        }
      ]
    },
    "fallback": {
      "match": "\\S+",
      "name": "comment.line.note.vasp"
    },
