        },
        {
          "match": "(?i)(?<![\\w.])(?:\\.(?:true|false)\\.|[TF]|true|false)(?![\\w.])",
          "name": "constant.language.boolean.vasp"
        },
        {
          "match": "(?<![\\w.])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eEdD][-+]?\\d+)?(?![\\w.])",
          "name": "constant.numeric.vasp"
        },
        {
          "match": "(?i)(?<!\\w)(?:eV(?:/(?:A|Angst(?:rom)?))?|meV|Ry|a\\.u\\.|bohr|angstrom|kB|GPa|THz|fs|ps|Kelvin|sec(?:onds)?)(?!\\w)",
          "name": "constant.numeric.unit.vasp"
        }
      ]
    },
    "title-value": {
      "begin": "(?i)^\\s*(SYSTEM|POSCAR|TITEL|COPYR|VRHFIN)(\\s*=\\s*)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.parameter.vasp"
        },
        "2": {
          "name": "keyword.other.operator.assignment.vasp"
        }
      },
      "contentName": "string.unquoted.title.vasp"
    },
    "echo-value": {
      "match": "(?i)(?<![\\w/])([A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*)(\\s*)(=)(\\s*)((?:[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eEdD][-+]?\\d+)?(?![\\w.])|\\.(?:true|false)\\.|[TF](?!\\w)|[A-Za-z_][\\w.-]*))",
      "captures": {
        "1": {
          "name": "keyword.other.parameter.vasp"
        },
        "3": {
          "name": "keyword.other.operator.assignment.vasp"
        },
        "5": {
          "name": "string.unquoted.option.vasp",
          "patterns": [
            {
              "include": "#output-values"
            }
          ]
        }
      }
    },
    "annotation": {
      "match": "[A-Za-z_][^\\n]*?(?=\\s+[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*\\s*=|$)",
      "name": "comment.line.note.vasp"
    },
    "output-group": {
      "match": "[()\\[\\]{},;]",
      "name": "comment.line.note.vasp"
    },
    "timing-label": {
      "match": "(?i)^\\s*((?:Total CPU|User|System|Elapsed) time)(\\s*\\(sec\\))(:)",
      "captures": {
        "1": {
          "name": "keyword.other.parameter.vasp"
        },
        "2": {
          "name": "keyword.other.parameter.vasp"
        },
        "3": {
          "name": "keyword.other.operator.vasp"
        }
      }
    },
    "diagnostics": {
      "patterns": [
        {
          "match": "(?i)\\b(?:fatal(?:\\s+error)?|internal\\s+error|ERROR(?::|\\b)|VERY BAD NEWS|ZBRENT: fatal error|BRMIX: very serious problems|EDDDAV: Call to ZHEGV failed|not converged)\\b",
          "name": "invalid.illegal.error.vasp"
        },
        {
          "match": "(?i)\\b(?:WARNING|ADVICE|WARNING:|W A R N I N G|E R R O R)\\b",
          "name": "markup.deleted.warning.vasp"
        },
        {
          "match": "(?i)(?:reached required accuracy[^\\n]*|aborting loop because EDIFF is reached|General timing and accounting informations for this job:)",
          "name": "markup.inserted.success.vasp"
        }
      ]
    },
    "headings": {
      "patterns": [
        {
          "match": "(?i)^\\s*(vasp\\.)(\\d+(?:\\.\\d+)+)(.*)$",
          "captures": {
            "1": {
              "name": "markup.heading.program.vasp"
            },
            "2": {
              "name": "constant.numeric.version.vasp"
            },
            "3": {
              "patterns": [
                {
                  "include": "#text"
                }
              ]
            }
          }
        },
        {
          "match": "(?i)^\\s*(?![A-Z][\\w/]*\\s*=)(?:POSITION\\s+TOTAL-FORCE|direct lattice vectors|reciprocal lattice vectors|FREE ENERGIE|VOLUME and BASIS|TOTAL-STRESS|FORCE on cell|EIGENVALUES(?![^\\n]*=)|BORN EFFECTIVE CHARGES|MACROSCOPIC STATIC DIELECTRIC TENSOR|DYNAMICAL MATRIX|SECOND DERIVATIVES|ELASTIC MODULI|total charge|magnetization\\s*\\([xyz]\\)|spin component|k-point\\s+\\d+\\s*:|band No\\.|N\\s+E\\s+dE|#\\s*of ion|ion\\s+s\\s+p\\s+d|Atomic configuration|Description|Following (?:cartesian|reciprocal) coordinates|Coordinates\\s+Weight|Startparameter for this run|Electronic Relaxation|Ionic relaxation|[>]?Blue_moon|[>]?Thermostat|[>]?Metadynamics)[^\\n]*",
          "name": "markup.heading.table.vasp"
        },
        {
          "match": "^\\s*[A-Z][A-Z /()-]{4,}:?\\s*$",
          "name": "markup.heading.section.vasp"
        },
        {
          "match": "^\\s*[-=*+|_]{4,}\\s*$",
          "name": "comment.line.separator.vasp"
        },
        {
          "match": "^\\s*(DAV|RMM|CG|DMP|RMM-DIIS|SDA|GAM|EDDIAG)(:)",
          "captures": {
            "1": {
              "name": "keyword.control.iteration.vasp"
            },
            "2": {
              "name": "keyword.other.operator.vasp"
            }
          }
        },
        {
          "match": "(?i)\\bIteration\\s+\\d+\\s*\\(\\s*\\d+\\s*\\)",
          "name": "markup.heading.iteration.vasp"
        }
      ]
    },
    "energy": {
      "match": "(?i)(?:free\\s+energy\\s+TOTEN|energy\\s+without\\s+entropy|energy\\(sigma->0\\)|E-fermi|E0|d\\s+E|F)(?=\\s*[=:])",
      "name": "keyword.other.energy.vasp"
    },
    "hash": {
      "match": "(?<!\\w)[a-fA-F0-9]{64}(?!\\w)",
      "name": "constant.numeric.hash.vasp"
    },
    "path": {
      "match": "(?:https?://|(?:\\.{1,2}/|/)[\\w])[\\w./~%+?=&:#@-]*",
      "name": "string.unquoted.path.vasp"
    },
    "file": {
      "match": "\\b(?:INCAR|POSCAR|CONTCAR|KPOINTS(?:_OPT)?|POTCAR|OUTCAR|OSZICAR|WAVECAR|CHGCAR|CHG|PROCAR|DOSCAR|EIGENVAL|IBZKPT|XDATCAR|LOCPOT|PARCHG|REPORT|vasprun\\.xml|vaspout\\.h5)\\b",
      "name": "string.unquoted.filename.vasp"
    },
    "orbitals": {
      "match": "(?<!\\w)(?:s|p[xyz]?|d(?:xy|yz|xz|z2|x2-y2)?|f|tot)(?!\\w)",
      "name": "constant.language.orbital.vasp"
    },
    "overflow": {
      "match": "\\*{3,}",
      "name": "invalid.illegal.numeric-overflow.vasp"
    },
    "row": {
      "match": "^\\s*[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eEdD][-+]?\\d+)?(?:\\s+[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eEdD][-+]?\\d+)?)*\\s*$",
      "name": "constant.numeric.row.vasp"
    },
    "text": {
      "patterns": [
        {
          "include": "#energy"
        },
        {
          "include": "#echo-value"
        },
        {
          "include": "#assignment"
        },
        {
          "include": "#hash"
        },
        {
          "include": "#output-values"
        },
        {
          "include": "#output-group"
        },
        {
          "include": "#annotation"
        },
        {
          "include": "#fallback"
        }
      ]
    }
  }
}
