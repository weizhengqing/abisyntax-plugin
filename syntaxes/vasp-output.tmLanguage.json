|DQ|WC|XC|LIBXC1_P\\d+|LIBXC2_P\\d+|XC\\d+_P\\d+|ML_INSTANCE_\\d+/(?:ML_[A-Z0-9_]+|IWAVPR)|IMAGE_\\d+/[A-Z][A-Z0-9_/]*)(?![\\w/])",
      "name": "keyword.other.parameter.vasp"
    },
    "assignment": {
      "match": "(?i)(?<![\\w/])([A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*)(\\s*)(=)",
      "captures": {
        "1": {
          "name": "keyword.other.parameter.vasp"
        },
        "3": {
          "name": "keyword.other.operator.assignment.vasp"
        }
      }
    },
    "values": {
      "patterns": [
        {
          "match": "(?i)(?<![\\w.])(?:\\.(?:true|false)\\.|\\.?[TF]\\.?(?![\\w.])|true\\b|false\\b)",
          "name": "constant.language.boolean.vasp"
