{
  "name": "abisyntax",
  "displayName": "ABINIT Syntax Highlighting",
  "description": "Syntax highlighting for ABINIT input files (all 1400+ variables of abinit, anaddb, optic, multibinit, aim and atdep), output/log files, and XYZ/POSCAR structures.",
  "version": "1.3.0",
  "publisher": "weizhengqing",
  "repository": {
    "type": "git",
    "url": "https://github.com/weizhengqing/abisyntax-plugin"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "abinit",
    "dft",
    "anaddb",
    "syntax",
    "highlighting"
  ],
  "scripts": {
    "build": "python3 tools/build_grammars.py",
    "update-variables": "python3 tools/fetch_variables.py && python3 tools/build_grammars.py",
    "test": "node test/run-tests.js"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "abinit",
        "aliases": [
          "ABINIT",
          "abinit"
        ],
        "extensions": [
          ".abi",
          ".in",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "abinit-output",
        "aliases": [
          "ABINIT Output",
          "abinit-output"
        ],
        "extensions": [
          ".abo",
          ".output",
          ".log",
          ".err"
        ],
        "filenamePatterns": [
          "*_EIG",
          "*_DDB",
          "*_DOS",
          "*_DOS_AT*",
          "*_PHFRQ",
          "*_GW",
          "*_SIGRES"
        ],
        "firstLine": "^(\\.Version \\d+\\.\\d+\\.\\d+ of [A-Z0-9]+|\\s*ABINIT \\d+\\.\\d+\\.\\d+\\s*$)",
        "configuration": "./language-configuration-output.json"
      },
      {
        "id": "abinit-xyz",
        "aliases": [
          "ABINIT XYZ",
          "xyz"
        ],
        "extensions": [
          ".xyz"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "abinit-vasp",
        "aliases": [
          "ABINIT VASP",
          "vasp"
        ],
        "extensions": [
          ".vasp",
          ".poscar"
        ],
        "filenames": [
          "POSCAR",
          "CONTCAR"
        ],
        "filenamePatterns": [
          "POSCAR*",
          "CONTCAR*"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "abinit",
        "scopeName": "source.abinit",
        "path": "./syntaxes/abinit.tmLanguage.json"
      },
      {
        "language": "abinit-output",
        "scopeName": "source.abinit-output",
        "path": "./syntaxes/abinit-output.tmLanguage.json"
      },
      {
        "language": "abinit-xyz",
        "scopeName": "source.xyz",
        "path": "./syntaxes/abinit-xyz.tmLanguage.json"
      },
      {
        "language": "abinit-vasp",
        "scopeName": "source.vasp",
        "path": "./syntaxes/abinit-vasp.tmLanguage.json"
      }
    ]
  }
}
